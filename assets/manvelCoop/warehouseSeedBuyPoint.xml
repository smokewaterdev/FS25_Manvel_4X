<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="buyingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="$data/shared/xml/schema/placeable.xsd">
    <storeData>
        <name>Manvel Cooperative - Seed Warehouse</name>
        <image>$data/objects/pallets/pioneer/store_pioneerPallet.png</image>
        <price>0</price>
        <canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
    </storeData>
    <base>
        <filename>assets/manvelCoop/buyPointTrigger.i3d</filename>
        <boughtWithFarmland>false</boughtWithFarmland>
        <canBeRenamed>false</canBeRenamed>
    </base>
    <buyingStation node="buyingStation" supportsExtension="false">
        <loadTrigger triggerNode="loadingTrigger" aiNode="loadingTriggerAINode" fillTypes="SEEDS" fillLitersPerSecond="500" infiniteCapacity="true"/>
        <fillType name="SEEDS" priceScale="1"/>
    </buyingStation>
    <hotspots>
        <hotspot type="LOADING" linkNode="mapPosition" teleportNode="markerLoading"/>
    </hotspots>
    <triggerMarkers>
        <triggerMarker node="markerLoading" filename="$data/shared/assets/marker/markerIconLoad.i3d"/>
    </triggerMarkers>
    <i3dMappings>
        <i3dMapping id="buyingStation" node="0>0"/>
        <i3dMapping id="loadingTrigger" node="0>0|0"/>
        <i3dMapping id="loadingTriggerAINode" node="0>0|1"/>
        <i3dMapping id="mapPosition" node="0>1"/>
        <i3dMapping id="markerLoading" node="0>2"/>
    </i3dMappings>
</placeable>
