<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="warehouse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="$data/shared/xml/schema/placeable.xsd">
    <storeData>
        <name>Manvel Cooperative - Seed &amp; Input Warehouse</name>
        <image>$data/objects/pallets/pioneer/store_pioneerPallet.png</image>
        <price>0</price>
        <canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
    </storeData>
    <base>
        <filename>assets/manvelCoop/buyPointTrigger.i3d</filename>
        <boughtWithFarmland>false</boughtWithFarmland>
        <canBeDeleted>false</canBeDeleted>
        <canBeRenamed>false</canBeRenamed>
    </base>

    <hotspots>
        <hotspot type="SHOP" linkNode="palletBuyingActivationTriggerMarker" teleportNode="palletBuyingActivationTriggerMarker" />
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="palletBuyingActivationTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconShopping.i3d"/>
    </triggerMarkers>

    <palletBuyingStation triggerNode="palletBuyingActivationTrigger">
        <fillType name="SEEDS"          priceScale="1.15" />
        <fillType name="FERTILIZER"     priceScale="1.15" />
        <fillType name="LIME"           priceScale="1.15" />
        <fillType name="SILAGE_ADDITIVE" priceScale="1.15" />
        <fillType name="MINERAL_FEED"   priceScale="1.15" />
        <fillType name="ROADSALT"       priceScale="1.15" />

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01" palletRotationOffset="90"/>
            </spawnPlaces>
        </palletSpawner>
    </palletBuyingStation>

    <i3dMappings>
        <i3dMapping id="mapPosition" node="0>1"/>
        <i3dMapping id="markerLoading" node="0>2"/>
        <i3dMapping id="palletBuyingActivationTriggerMarker" node="0>3"/>
        <i3dMapping id="palletBuyingActivationTrigger" node="0>4"/>
        <i3dMapping id="palletAreaStart01" node="0>5"/>
        <i3dMapping id="palletAreaEnd01" node="0>5|0"/>
    </i3dMappings>
</placeable>
