<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="workshop" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>Manvel Home Farm Workshop</name>
        <image>$data/store/store_empty.png</image>
        <price>0</price><canBeSold>false</canBeSold><showInStore>false</showInStore><lifetime>1000</lifetime>
        <rotation>0</rotation><brand>NONE</brand><species>PLACEABLE</species><category>placeableMisc</category>
    </storeData>
    <base>
        <filename>assets/vehicleDealer/workshopTrigger.i3d</filename>
        <boughtWithFarmland>false</boughtWithFarmland><canBeRenamed>false</canBeRenamed>
    </base>
    <deletedNodes>
        <deletedNode node="tipOcclusionUpdateAreas"/><deletedNode node="collisions"/>
    </deletedNodes>
    <placement useRandomYRotation="false" useManualYRotation="true"/>
    <hotspots>
        <hotspot type="SHOP" linkNode="hotspotNode" teleportNode="teleportNode" text="Home Farm Workshop"/>
    </hotspots>
    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true"/>
    </triggerMarkers>
    <workshop>
        <sellingPoint playerTriggerNode="playerInteractionTrigger" iconNode="workshopMarker" sellTriggerNode="vehicleTrigger" ownWorkshop="true"/>
    </workshop>
    <i3dMappings>
        <i3dMapping id="vehicleTrigger" node="0>0"/>
        <i3dMapping id="warningStripes01" node="0>1"/>
        <i3dMapping id="playerInteractionTrigger" node="0>2"/>
        <i3dMapping id="workshopMarker" node="0>2|0"/>
        <i3dMapping id="playerTriggerMarker" node="0>2|0|0"/>
        <i3dMapping id="hotspotNode" node="0>3"/>
        <i3dMapping id="teleportNode" node="0>4"/>
        <i3dMapping id="tipOcclusionUpdateAreas" node="0>5"/>
        <i3dMapping id="collisions" node="0>6"/>
    </i3dMappings>
</placeable>
