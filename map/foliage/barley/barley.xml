<?xml version='1.0' encoding='utf-8'?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="barley" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.2502 0.1683 0.0612 1" colorBlind="0.6795 0.6867 0.7231 1" />
        <windrow fillType="straw" litersPerSqm="3.68" cutFillType="BARLEY_CUT" windrowCutFactor="1.25" />
        <harvest litersPerSqm="0.96" cutHeight="0.15" chopperType="CHOPPER_STRAW">
            <transition src="greenBig2" target="harvestedGreen" />
            <transition src="harvestReady" target="harvested" />
        </harvest>
        <growth resetsSpray="true" growthRequiresLime="true" />
        <soil lowDensityRequired="true" increasesDensity="false" consumesLime="true" startSprayLevel="0" />
        <seeding directionSnapAngle="0" needsRolling="true" litersPerSqm="0.0265" isAvailable="true" />
        <cultivation isAllowed="true" />
        <mulcher chopperType="CHOPPER_STRAW" />
    </fruitType>
    <thRowCropSystem spacingWidth="0.5" />
    <thFoliageDestruction>
        <wheelConversions>
            <convert minState="greenMiddle" maxState="greenBig2" toState="greenMiddleTracks" />
            <convert minState="harvestReady" maxState="harvestReady" toState="harvestReadyTracks" />
            <convert minState="dead" maxState="dead" toState="cutTracks" />
            <convert minState="harvestedGreen" maxState="harvestedGreen" toState="cutGreenTracks" />
            <convert minState="harvested" maxState="harvested" toState="cutTracks" />
        </wheelConversions>
        <disasterConversions>
            <convert minState="greenMiddle" maxState="greenBig2" toState="greenMiddleTracks" />
            <convert minState="harvestReady" maxState="harvestReady" toState="harvestReadyTracks" />
            <convert minState="dead" maxState="dead" toState="cutTracks" />
            <convert minState="harvestedGreen" maxState="harvestedGreen" toState="cutGreenTracks" />
            <convert minState="harvested" maxState="harvested" toState="cutTracks" />
        </disasterConversions>
    </thFoliageDestruction>
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="5" plantSeparation="0.250 0.250" plantOffset="0.125 0.125" plantLayoutRotation="false" shapeSource="barley.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="0.8" height="1.0" widthVariance="0.2" heightVariance="0.2" horizontalPositionVariance="0" />
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageState name="invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true" />
        <foliageState name="greenSmall" width="0.5" height="0.6" distanceMap="distance/foliage_barley_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|0" />
                <foliageLod blockShape="0&gt;1|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenSmall2" width="0.6" height="0.8" distanceMap="distance/foliage_barley_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|0" />
                <foliageLod blockShape="0&gt;1|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddle" width="0.6" height="0.7" distanceMap="distance/foliage_barley_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|1" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddle2" width="0.7" height="0.9" distanceMap="distance/foliage_barley_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|1" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBig" width="0.6" height="0.8" distanceMap="distance/foliage_barley_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|2" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBig2" distanceMap="distance/foliage_barley_distance4_diffuse.png" isGrowing="true" isForageReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|2" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvestReady" width="0.9" distanceMap="distance/foliage_barley_distance5_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" groundType="HARVEST_READY">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|3" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
        </foliageState>
        <foliageState name="dead" distanceMap="distance/foliage_barley_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|4" />
                <foliageLod blockShape="0&gt;1|4" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvestedGreen" width="0.5" height="3.2" distanceMap="distance/foliage_barley_distance2_diffuse.png" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" cullCropsBelowFillHeight="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|6" />
                <foliageLod blockShape="0&gt;1|6" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvested" width="0.5" height="3.2" distanceMap="distance/foliage_barley_distance7_diffuse.png" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" cullCropsBelowFillHeight="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|5" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddleTracks" width="1.2" height="0.4" distanceMap="distance/foliage_barley_distance3_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|1" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvestReadyTracks" width="1.1" height="0.5" distanceMap="distance/foliage_barley_distance5_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|3" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
        </foliageState>
        <foliageState name="cutGreenTracks" width="0.8" height="0.8" distanceMap="distance/foliage_barley_distance2_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|6" />
                <foliageLod blockShape="0&gt;1|6" />
            </foliageShape>
        </foliageState>
        <foliageState name="cutTracks" width="0.8" height="0.8" distanceMap="distance/foliage_barley_distance7_diffuse.png" isDestructedByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|5" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
        </foliageState>
    </foliageLayer>
    <growth>
        <seasonal>
            <period name="EARLY_SPRING" />
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="EARLY_SUMMER">
                <update startState="greenSmall" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="MID_SUMMER">
                <update startState="greenSmall" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="greenSmall" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="MID_AUTUMN" />
            <period name="LATE_AUTUMN" />
            <period name="EARLY_WINTER" />
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" />
        </seasonal>
    </growth>
</foliageType>