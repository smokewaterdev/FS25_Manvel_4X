<?xml version='1.0' encoding='utf-8'?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="pea" shownOnMap="true" useForFieldMissions="false">
        <mapColors default="0.0252 0.2664 0.1221 1" colorBlind="0.8879 0.8069 0.7913 1" />
        <harvest litersPerSqm="0.96" chopperUseHaulm="true" />
        <growth resetsSpray="true" growthRequiresLime="true" />
        <soil lowDensityRequired="true" increasesDensity="true" consumesLime="true" startSprayLevel="0" />
        <seeding directionSnapAngle="0" needsRolling="false" litersPerSqm="0.025" isAvailable="true" />
        <cultivation isAllowed="true" />
        <haulm layerName="pea_haulm" />
    </fruitType>
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="2.5" shapeSource="$data/foliage/pea/pea.i3d">
        <foliageStateDefaults distanceMapLayer="1" width="1" height="1" widthVariance="0.4" heightVariance="0.2" horizontalPositionVariance="0.4" />
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" texCoords="0 0 1 1" />
        <foliageState name="invisible" isGrowing="true" allowsHoeing="true" />
        <foliageState name="greenSmall" distanceMap="$data/foliage/pea/distance/foliage_pea_distance1_diffuse.png" isGrowing="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|0|0" />
                <foliageLod blockShape="0&gt;1|0|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddle" distanceMap="$data/foliage/pea/distance/foliage_pea_distance2_diffuse.png" isGrowing="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|1|0" />
                <foliageLod blockShape="0&gt;1|1|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBig" distanceMap="$data/foliage/pea/distance/foliage_pea_distance3_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|2|0" />
                <foliageLod blockShape="0&gt;1|2|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvestReady" distanceMap="$data/foliage/pea/distance/foliage_pea_distance4_diffuse.png" isGrowing="true" isHarvestReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" groundType="HARVEST_READY_OTHER">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|3|0" />
                <foliageLod blockShape="0&gt;1|3|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="dead" distanceMap="$data/foliage/pea/distance/foliage_pea_distance5_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|4|0" />
                <foliageLod blockShape="0&gt;1|4|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvested" isCut="true" numBlocksPerUnit="1.5" distanceMap="$data/foliage/pea/distance/foliage_pea_distance6_diffuse.png" isDestructedByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|5|0" />
                <foliageLod blockShape="0&gt;1|5|0" />
            </foliageShape>
        </foliageState>
    </foliageLayer>
    <foliageLayer name="haulm" densityMapChannelOffset="4" numDensityMapChannels="1" numBlocksPerUnit="2.0" shapeSource="$data/foliage/pea/peaHaulm.i3d">
        <foliageStateDefaults width="0.6" height="0.6" widthVariance="0" heightVariance="0" horizontalPositionVariance="0.3" />
        <foliageLodDefaults lod="0" viewDistance="80" />
        <foliageState distanceMapLayer="2" distanceMap="$data/foliage/pea/distance/foliage_pea_distance7_diffuse.png">
            <foliageShape>
                <foliageLod blockShape="0" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
            </foliageShape>
        </foliageState>
    </foliageLayer>
    <growth>
        <seasonal initialState="greenBig">
            <period name="EARLY_SPRING" />
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="EARLY_SUMMER">
                <update startState="greenSmall" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="MID_SUMMER">
                <update startState="greenSmall" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="greenSmall" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="MID_AUTUMN" />
            <period name="LATE_AUTUMN" />
            <period name="EARLY_WINTER" />
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" />
        </seasonal>
    </growth>
</foliageType>