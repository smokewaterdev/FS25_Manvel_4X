<?xml version='1.0' encoding='utf-8'?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="soybean" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.2195 0.2346 0.0273 1" colorBlind="0.3564 0.3095 0.0437 1" />
        <windrow litersPerSqm="3.68" cutFillType="SOYBEAN_CUT" windrowCutFactor="1.25" />
        <harvest litersPerSqm="0.45" cutHeight="0.20" chopperType="CHOPPER_STRAW" forageCutHeight="0.15" />
        <growth resetsSpray="true" growthRequiresLime="true" />
        <soil lowDensityRequired="true" increasesDensity="false" consumesLime="true" startSprayLevel="0" />
        <seeding directionSnapAngle="0" needsRolling="true" litersPerSqm="0.0214" isAvailable="true" />
        <cultivation isAllowed="true" />
        <mulcher chopperType="CHOPPER_STRAW" />
    </fruitType>
    <thRowCropSystem spacingWidth="0.75" />
    <thFoliageDestruction>
        <wheelConversions>
            <convert minState="greenMiddle" maxState="greenMiddle2" toState="greenMiddleTracks" />
            <convert minState="greenBig" maxState="greenBig2" toState="greenBigTracks" />
            <convert minState="harvestReady" maxState="harvestReady" toState="harvestReadyTracks" />
            <convert minState="dead" maxState="dead" toState="deadTracks" />
            <convert minState="harvested" maxState="harvested" toState="cutTracks" />
        </wheelConversions>
        <disasterConversions>
            <convert minState="greenMiddle" maxState="greenMiddle2" toState="greenMiddleTracks" />
            <convert minState="greenBig" maxState="greenBig2" toState="greenBigTracks" />
            <convert minState="harvestReady" maxState="harvestReady" toState="harvestReadyTracks" />
            <convert minState="dead" maxState="dead" toState="deadTracks" />
            <convert minState="harvested" maxState="harvested" toState="cutTracks" />
        </disasterConversions>
    </thFoliageDestruction>
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="5" plantSeparation="0.250 0.250" plantOffset="0.125 0.125" plantLayoutRotation="false" shapeSource="soybean.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="1.0" height="1.0" widthVariance="0.1" heightVariance="0.2" horizontalPositionVariance="0" />
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageState name="invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true" />
        <foliageState name="greenSmall" width="0.9" height="0.9" distanceMap="distance/foliage_soybean_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|0" />
                <foliageLod blockShape="0&gt;1|0" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|1" />
                <foliageLod blockShape="0&gt;1|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddle" width="0.8" height="0.8" distanceMap="distance/foliage_soybean_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|2" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|3" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddle2" distanceMap="distance/foliage_soybean_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|2" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|3" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBig" width="0.9" height="0.9" distanceMap="distance/foliage_soybean_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|4" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|5" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBig2" width="1.1" height="1.1" distanceMap="distance/foliage_soybean_distance4_diffuse.png" isGrowing="true" isForageReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|4" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|5" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvestReady" height="1.1" distanceMap="distance/foliage_soybean_distance5_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" groundType="HARVEST_READY">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|6" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|7" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
        </foliageState>
        <foliageState name="dead" distanceMap="distance/foliage_soybean_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|8" />
                <foliageLod blockShape="0&gt;1|4" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|9" />
                <foliageLod blockShape="0&gt;1|4" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvested" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" cullCropsBelowFillHeight="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|10" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|11" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddleTracks" width="1.0" height="0.3" distanceMap="distance/foliage_soybean_distance3_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|2" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|3" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBigTracks" width="1.3" height="0.5" distanceMap="distance/foliage_soybean_distance4_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|4" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|5" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvestReadyTracks" width="1.2" height="0.4" distanceMap="distance/foliage_soybean_distance5_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|6" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|7" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
        </foliageState>
        <foliageState name="deadTracks" width="1.2" height="0.4" distanceMap="distance/foliage_soybean_distance6_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|8" />
                <foliageLod blockShape="0&gt;1|4" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|9" />
                <foliageLod blockShape="0&gt;1|4" />
            </foliageShape>
        </foliageState>
        <foliageState name="cutTracks" height="0.2" isDestructedByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|10" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|11" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
        </foliageState>
    </foliageLayer>
    <growth>
        <seasonal initialState="greenMiddle2">
            <period name="EARLY_SPRING" />
            <period name="MID_SPRING" />
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="EARLY_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="MID_SUMMER">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
            </period>
            <period name="MID_AUTUMN">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
            </period>
            <period name="LATE_AUTUMN">
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="EARLY_WINTER" />
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" />
        </seasonal>
    </growth>
</foliageType>