<?xml version='1.0' encoding='utf-8'?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="cotton" shownOnMap="true" useForFieldMissions="false">
        <mapColors default="0.8879 0.8069 0.7913 1" colorBlind="0.0546 0.0818 0.2789 1" />
        <harvest litersPerSqm="0.497" />
        <growth resetsSpray="true" growthRequiresLime="true" />
        <soil lowDensityRequired="true" increasesDensity="false" consumesLime="true" startSprayLevel="0" />
        <seeding directionSnapAngle="0" litersPerSqm="0.005" isAvailable="true" />
        <cultivation isAllowed="true" />
    </fruitType>
    <thRowCropSystem spacingWidth="1.0" />
    <thFoliageDestruction>
        <wheelConversions>
            <convert minState="greenMiddle" maxState="greenMiddle3" toState="greenMiddleTracks" />
            <convert minState="greenBig" maxState="greenBig2" toState="greenBigTracks" />
            <convert minState="harvestReady" maxState="harvested" toState="deadTracks" />
        </wheelConversions>
        <disasterConversions>
            <convert minState="greenMiddle" maxState="greenMiddle3" toState="greenMiddleTracks" />
            <convert minState="greenBig" maxState="greenBig2" toState="greenBigTracks" />
            <convert minState="harvestReady" maxState="harvested" toState="destroyed" />
        </disasterConversions>
    </thFoliageDestruction>
