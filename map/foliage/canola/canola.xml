<?xml version='1.0' encoding='utf-8'?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="canola" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.3324 0.5395 0.0823 1" colorBlind="0.7681 0.6514 0.0529 1" />
        <windrow litersPerSqm="3.68" cutFillType="CANOLA_CUT" windrowCutFactor="1.25" />
        <harvest litersPerSqm="0.58" cutHeight="0.30" chopperType="CHOPPER_STRAW" forageCutHeight="0.15" beeYieldBonusPercentage="0.05" />
        <growth resetsSpray="true" growthRequiresLime="true" />
        <soil lowDensityRequired="true" increasesDensity="false" consumesLime="true" startSprayLevel="0" />
        <seeding directionSnapAngle="0" needsRolling="true" litersPerSqm="0.0049" isAvailable="true" />
        <cultivation isAllowed="true" />
        <mulcher chopperType="CHOPPER_STRAW" />
    </fruitType>
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="1.5" shapeSource="$data/foliage/canola/canola.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="1.0" height="1.0" widthVariance="0" heightVariance="0.2" horizontalPositionVariance="0.5" />
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageState name="invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true" />
        <foliageState name="greenSmall" numBlocksPerUnit="2.8" distanceMap="$data/foliage/canola/distance/foliage_canola_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|0" />
                <foliageLod blockShape="0&gt;1|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenSmall2" numBlocksPerUnit="2.8" distanceMap="$data/foliage/canola/distance/foliage_canola_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|0" />
                <foliageLod blockShape="0&gt;1|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenSmall3" numBlocksPerUnit="2.8" distanceMap="$data/foliage/canola/distance/foliage_canola_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|0" />
                <foliageLod blockShape="0&gt;1|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddle" numBlocksPerUnit="2" distanceMap="$data/foliage/canola/distance/foliage_canola_distance3_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|1" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddle2" numBlocksPerUnit="2" distanceMap="$data/foliage/canola/distance/foliage_canola_distance3_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|1" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBig" numBlocksPerUnit="1.4" width="1.2" distanceMap="$data/foliage/canola/distance/foliage_canola_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|2" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBig2" numBlocksPerUnit="1.4" width="1.2" distanceMap="$data/foliage/canola/distance/foliage_canola_distance4_diffuse.png" isGrowing="true" isForageReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|2" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvestReady" width="1.6" distanceMap="$data/foliage/canola/distance/foliage_canola_distance5_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" groundType="HARVEST_READY_OTHER">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|3" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
        </foliageState>
        <foliageState name="dead" distanceMap="$data/foliage/canola/distance/foliage_canola_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|4" />
                <foliageLod blockShape="0&gt;1|4" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvested" numBlocksPerUnit="2.0" distanceMap="$data/foliage/canola/distance/foliage_canola_distance7_diffuse.png" isCut="true" isDestructedByWheel="true" isDestructibleByDisaster="true" cullCropsBelowFillHeight="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|5" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
        </foliageState>
    </foliageLayer>
    <growth>
        <seasonal initialState="harvestReady">
            <period name="EARLY_SPRING" />
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="EARLY_SUMMER">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="MID_SUMMER">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="MID_AUTUMN">
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="LATE_AUTUMN" />
            <period name="EARLY_WINTER" />
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" />
        </seasonal>
    </growth>
</foliageType>