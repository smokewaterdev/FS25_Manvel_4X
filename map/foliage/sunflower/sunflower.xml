        </foliageState>
        <foliageState name="greenMiddle2" distanceMap="$data/foliage/sunflower/distance/foliage_sunflower_distance3_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
