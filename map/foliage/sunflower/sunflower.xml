<?xml version='1.0' encoding='utf-8'?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="sunflower" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.8227 0.5972 0.0160 1" colorBlind="0.1384 0.1559 0.2423 1" />
        <harvest litersPerSqm="0.52" cutHeight="1.0" chopperType="CHOPPER_MAIZE" forageCutHeight="0.15" beeYieldBonusPercentage="0.05" />
        <growth resetsSpray="true" growthRequiresLime="true" />
        <soil lowDensityRequired="true" increasesDensity="false" consumesLime="true" startSprayLevel="0" />
        <seeding directionSnapAngle="0" litersPerSqm="0.0143" isAvailable="true" defaultSowingGroundType="PLANTED" />
        <cultivation isAllowed="true" />
        <mulcher chopperType="CHOPPER_MAIZE" />
    </fruitType>
    <thRowCropSystem spacingWidth="0.750" />
    <thFoliageDestruction>
        <wheelConversions>
            <convert minState="greenSmall" maxState="greenMiddle2" toState="greenSmallTracks" />
            <convert minState="greenBig" maxState="greenBig2" toState="greenBigTracks" />
            <convert minState="harvestReady" maxState="harvestReady" toState="harvestReadyTracks" />
            <convert minState="dead" maxState="dead" toState="deadTracks" />
            <convert minState="harvested" maxState="harvested" toState="cutTracks" />
        </wheelConversions>
        <disasterConversions>
            <convert minState="greenSmall" maxState="greenMiddle2" toState="greenSmallTracks" />
            <convert minState="greenBig" maxState="greenBig2" toState="greenBigTracks" />
            <convert minState="harvestReady" maxState="harvestReady" toState="harvestReadyTracks" />
            <convert minState="dead" maxState="dead" toState="deadTracks" />
            <convert minState="harvested" maxState="harvested" toState="cutTracks" />
        </disasterConversions>
    </thFoliageDestruction>
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="5" plantSeparation="0.250 0.250" plantOffset="0.125 0.125" plantLayoutRotation="false" shapeSource="sunflower.i3d" alignsToSun="true">
        <foliageStateDefaults distanceMapLayer="1" width="0.9" height="1" widthVariance="0.2" heightVariance="0.2" horizontalPositionVariance="0" />
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" texCoords="0 0 1 1" />
        <foliageState name="invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true" />
        <foliageState name="greenSmall" width="0.7" height="0.8" distanceMap="distance/foliage_sunflower_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|0" />
                <foliageLod blockShape="0&gt;1|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenSmall2" distanceMap="distance/foliage_sunflower_distance2_diffuse.png" isGrowing="true" allowsWeeding="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|0" />
                <foliageLod blockShape="0&gt;1|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddle" width="0.7" height="0.8" distanceMap="distance/foliage_sunflower_distance3_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|1" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|2" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenMiddle2" distanceMap="distance/foliage_sunflower_distance3_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|1" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|2" />
                <foliageLod blockShape="0&gt;1|1" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBig" width="0.7" height="0.8" distanceMap="distance/foliage_sunflower_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|3" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|4" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|5" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|6" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBig2" distanceMap="distance/foliage_sunflower_distance4_diffuse.png" isGrowing="true" isForageReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|3" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|4" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|5" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|6" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvestReady" distanceMap="distance/foliage_sunflower_distance5_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" groundType="HARVEST_READY_OTHER">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|7" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|8" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
        </foliageState>
        <foliageState name="dead" distanceMap="distance/foliage_sunflower_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|9" />
                <foliageLod blockShape="0&gt;1|4" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|10" />
                <foliageLod blockShape="0&gt;1|4" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvested" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|11" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|12" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenSmallTracks" width="1.8" height="0.4" distanceMap="distance/foliage_sunflower_distance2_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|0" />
                <foliageLod blockShape="0&gt;1|0" />
            </foliageShape>
        </foliageState>
        <foliageState name="greenBigTracks" width="0.8" height="0.2" distanceMap="distance/foliage_sunflower_distance4_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|3" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|4" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|5" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|6" />
                <foliageLod blockShape="0&gt;1|2" />
            </foliageShape>
        </foliageState>
        <foliageState name="harvestReadyTracks" widht="1.8" height="0.4" distanceMap="distance/foliage_sunflower_distance5_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|7" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|8" />
                <foliageLod blockShape="0&gt;1|3" />
            </foliageShape>
        </foliageState>
        <foliageState name="deadTracks" width="1.8" height="0.4" distanceMap="distance/foliage_sunflower_distance6_diffuse.png" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|9" />
                <foliageLod blockShape="0&gt;1|4" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|10" />
                <foliageLod blockShape="0&gt;1|4" />
            </foliageShape>
        </foliageState>
        <foliageState name="cutTracks" width="1.5" height="0.4" isDestructedByWheel="true" isDestructibleByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0&gt;0|11" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0&gt;0|12" />
                <foliageLod blockShape="0&gt;1|5" />
            </foliageShape>
        </foliageState>
    </foliageLayer>
    <growth>
        <seasonal initialState="greenMiddle2">
            <period name="EARLY_SPRING" />
            <period name="MID_SPRING" />
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="EARLY_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="MID_SUMMER">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="MID_AUTUMN">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="LATE_AUTUMN">
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="EARLY_WINTER">
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" />
        </seasonal>
    </growth>
</foliageType>