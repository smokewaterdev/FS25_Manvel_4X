        <foliageState name="invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true" />
        <foliageState name="greenSmall" distanceMap="$data/foliage/sunflower/distance/foliage_sunflower_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true">
