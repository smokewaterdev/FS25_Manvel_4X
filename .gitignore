# GIANTS Editor terrain caches (regenerate automatically on load/save)
*.i3d.terrain.lod.type.cache
*.i3d.terrain.nmap.cache
*.i3d.terrain.occluders.cache

# Manual backup copies made during editing (git history is the real backup)
*_backup.*

# OS junk
Thumbs.db
desktop.ini

# Python build junk
__pycache__/
*.pyc

# Traffic pipeline staging output — regenerated from map/CSVdata3 by
# tools/traffic/*.py, already merged into map/map.i3d. Not source, not shipped.
tools/traffic/manvel_traffic_import.i3d
tools/traffic/csvsplines_terrain_snap.i3d
tools/traffic/parked_cars.i3d
AutoDrive*.xml

# Release build output (tools/build_release.py)
/releases/

# Regenerable dev-tool preview images (see each tool's README for the
# one-line command to rebuild). Not runtime assets, not worth tracking.
tools/pda/pda_output.png
tools/soilMap/soilMap_preview.png
